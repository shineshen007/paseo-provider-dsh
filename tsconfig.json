{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "index.server.ts",
    "shared/**/*.ts",
    "server/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.mjs",
    "dsh-bridge/src/**/*.ts"
  ]
}
